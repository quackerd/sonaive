/bin/sh -c "
set -eu

# Overwrite system DNS to route all container traffic through MosDNS
echo 'nameserver 127.0.0.1' > /etc/resolv.conf

mkdir -p /opt/sonaive/data/www
chown -R docker:docker /opt/sonaive/data

exec s6-envdir /var/run/s6/container_environment exec s6-setuidgid docker python3 /opt/sonaive/init/init.py"