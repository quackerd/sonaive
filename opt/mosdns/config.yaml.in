log:
  level: {{ LOG_LEVEL }}
  file: "/opt/sonaive/data/mosdns/logs/mosdns.log"

plugins:
  - tag: cache
    type: cache
    args:
      size: 10240             # Cache up to 10240 domain records in RAM
      lazy_cache_ttl: 172800   # Serve stale cache for up to 48 hours while updating in background
      dump_file: /opt/sonaive/data/mosdns/cache/cache.dump
      dump_interval: 600    # Interval (in seconds) to automatically save the cache

  - tag: match_cn
    type: domain_set
    args:
      files:
        - "/opt/sonaive/domains/cn-list.txt"
        - "/opt/sonaive/domains/cn-tld.txt"

  - tag: match_ads
    type: domain_set
    args:
      files:
        - "/opt/sonaive/domains/tif.txt"
        - "/opt/sonaive/domains/pro.txt"
        - "/opt/sonaive/domains/tld.txt"

  - tag: match_ads_allow
    type: domain_set
    args:
      files:
        - "/opt/sonaive/domains/tld-allow.txt"

  - tag: upstreams
    type: forward
    args:
      concurrent: 2
      upstreams:
        - addr: "https://dns.google/dns-query"
          dial_addr: "8.8.8.8"
          enable_pipeline: true
          enable_http3: true
        - addr: "https://cloudflare-dns.com/dns-query"
          dial_addr: "1.1.1.1"
          enable_pipeline: true
          enable_http3: true

  - tag: main_sequence
    type: sequence
    args:
      {% if BLOCK_CN %}
      - matches: qname $match_cn
        exec: reject 3
      {% endif %}

      {% if BLOCK_ADS %}
      - matches:
          - qname $match_ads
          - "!qname $match_ads_allow"
        exec: reject 3
      {% endif %}

      - exec: $cache
      - matches: has_resp
        exec: accept

      - exec: $upstreams
      - matches: has_resp
        exec: accept

  - tag: udp_server
    type: udp_server
    args:
      entry: main_sequence
      listen: ":53" # MOSDNS listening port (UDP)

  - tag: tcp_server
    type: tcp_server
    args:
      entry: main_sequence
      listen: ":53" # MOSDNS listening port (TCP)