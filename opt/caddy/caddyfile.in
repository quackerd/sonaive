# Environment Variables (Passed via Jinja2 Context):
# HOST         : Public domain name
# PORT         : HTTPS bind port (typically 443)
# USERS        : Formatted block of "basic_auth user pass"
# BLOCK_LOCAL  : Boolean (True/False) to drop local subnets
# BLOCK_CN     : Boolean (True/False) to drop CN IPs

# Global Options Block
{
    {% if ENABLE_ADMIN %}
    admin :2019
    {% else %}
    admin off
    {% endif %}

    persist_config off

    {% if DEV %}
    skip_install_trust
    {% endif %}

    order forward_proxy first

    log {
        output file /opt/sonaive/data/caddy/logs/system.log
        format json
        level {{ LOG_LEVEL }}
    }

    http_port 80
    https_port 443
}

http://{{ HOST }}:80 {
    redir https://{{ HOST }}:{{ PORT }}{uri} 308
}

:443, {{ HOST }} {
    {% if DEV %}
    tls internal
    {% elif CERT_DIR %}
    tls {{ CERT_DIR }}/fullchain.pem {{ CERT_DIR }}/privkey.pem
    {% endif %}

    header >Alt-Svc `h3=":{{ PORT }}"; ma=86400`

    encode
    forward_proxy {
        {{ USERS }}
        hide_ip
        hide_via
        probe_resistance

        # Local plaintext proxy-chain hop into sing-box.
        # Required because forward_proxy rejects insecure upstreams by default.
        disable_insecure_upstreams_check
        upstream http://127.0.0.1:2080
    }

    {{ WEBLINKS }}

    handle {
        {% if DEFAULT_SITE %}
        root * /opt/sonaive/www
        {% else %}
        root * /opt/sonaive/data/www
        {% endif %}
        file_server
    }

    log {
        output file /opt/sonaive/data/caddy/logs/access.log
        format json
        level {{ LOG_LEVEL }}
    }
}
