# Environment variables and generated values passed via the Jinja2 context:
# HOST           : Public domain name
# PORT           : Public HTTPS port advertised in redirects and Alt-Svc
# DEV            : Whether to use Caddy's internal development CA
# CERT_DIR       : Directory containing manual fullchain.pem and privkey.pem files
# ENABLE_ADMIN   : Whether to expose Caddy's admin API on container port 2019
# DEFAULT_SITE   : Whether to serve the bundled site instead of data/www
# LOG_LEVEL      : Caddy log verbosity
# USERS          : Generated block of "basic_auth user password" entries
# WEBLINKS       : Generated Caddy routes for per-user link pages

# Global Options Block
{
    {% if ENABLE_ADMIN %}
    admin :2019
    {% else %}
    admin off
    {% endif %}

    persist_config off

    {% if DEV %}
    skip_install_trust
    {% elif CERT_DIR %}
    auto_https disable_certs
    {% endif %}

    order forward_proxy first

    log {
        output file /opt/sonaive/data/caddy/logs/system.log
        format json
        level {{ LOG_LEVEL }}
    }

    http_port 80
    https_port 443
}

http://{{ HOST }}:80 {
    redir https://{{ HOST }}:{{ PORT }}{uri} 308
}

:443, https://{{ HOST }}:443 {
    {% if DEV %}
    tls internal
    {% elif CERT_DIR %}
    tls {{ CERT_DIR }}/fullchain.pem {{ CERT_DIR }}/privkey.pem
    {% endif %}

    header >Alt-Svc `h3=":{{ PORT }}"; ma=86400`

    encode
    forward_proxy {
        {{ USERS }}
        hide_ip
        hide_via
        probe_resistance

        # Local plaintext proxy-chain hop into sing-box.
        # Required because forward_proxy rejects insecure upstreams by default.
        disable_insecure_upstreams_check
        upstream http://127.0.0.1:2080
    }

    {{ WEBLINKS }}

    handle {
        {% if DEFAULT_SITE %}
        root * /opt/sonaive/www
        {% else %}
        root * /opt/sonaive/data/www
        {% endif %}
        file_server
    }

    log {
        output file /opt/sonaive/data/caddy/logs/access.log
        format json
        level {{ LOG_LEVEL }}
    }
}
